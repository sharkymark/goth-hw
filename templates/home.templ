package templates

templ Home() {
	@Layout("SF Browser") {
		<div class="space-y-4">
			<h1 class="text-2xl font-bold">Salesforce Browser</h1>
			<p class="text-gray-600">Select an object from the navigation to browse records.</p>
			<div class="grid grid-cols-2 md:grid-cols-5 gap-4 mt-8">
				<a href="/activities" class="p-4 bg-white rounded shadow hover:shadow-lg transition-shadow border-l-4 border-hn-orange">
					<h2 class="font-semibold">Activities</h2>
					<p class="text-sm text-gray-500">Recent lead activities</p>
				</a>
				<a href="/objects/Account" class="p-4 bg-white rounded shadow hover:shadow-lg transition-shadow border-l-4 border-hn-orange">
					<h2 class="font-semibold">Accounts</h2>
					<p class="text-sm text-gray-500">Browse account records</p>
				</a>
				<a href="/objects/Contact" class="p-4 bg-white rounded shadow hover:shadow-lg transition-shadow border-l-4 border-hn-orange">
					<h2 class="font-semibold">Contacts</h2>
					<p class="text-sm text-gray-500">Browse contact records</p>
				</a>
				<a href="/objects/Opportunity" class="p-4 bg-white rounded shadow hover:shadow-lg transition-shadow border-l-4 border-hn-orange">
					<h2 class="font-semibold">Opportunities</h2>
					<p class="text-sm text-gray-500">Browse opportunity records</p>
				</a>
				<a href="/objects/Lead" class="p-4 bg-white rounded shadow hover:shadow-lg transition-shadow border-l-4 border-hn-orange">
					<h2 class="font-semibold">Leads</h2>
					<p class="text-sm text-gray-500">Browse lead records</p>
				</a>
			</div>
		</div>
	}
}
