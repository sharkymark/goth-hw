package templates

templ Layout(title string) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title }</title>
			<script src="https://unpkg.com/htmx.org@2.0.4"></script>
			<link href="/static/styles.css" rel="stylesheet"/>
		</head>
		<body class="bg-hn-beige min-h-screen">
			<header class="bg-hn-orange p-2">
				<nav class="container mx-auto flex items-center gap-4">
					<a href="/" class="font-bold text-black text-lg">SF Browser</a>
					<a href="/activities" class="text-black hover:underline">Activities</a>
					<a href="/objects/Account" class="text-black hover:underline">Accounts</a>
					<a href="/objects/Contact" class="text-black hover:underline">Contacts</a>
					<a href="/objects/Opportunity" class="text-black hover:underline">Opportunities</a>
					<a href="/objects/Lead" class="text-black hover:underline">Leads</a>
				</nav>
			</header>
			<main class="container mx-auto p-4">
				{ children... }
			</main>
		</body>
	</html>
}
